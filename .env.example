# ── 쿠팡 Wing 오픈 API ─────────────────────────────
# Wing 로그인 → 'API 연동' 메뉴에서 발급
# 업체코드(Vendor ID)는 A로 시작합니다 (예: A00012345)
COUPANG_VENDOR_ID=
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# ── Threads API ───────────────────────────────────
# Meta 개발자 앱에서 Threads use case 설정 후 발급받은 장기 토큰 (60일 유효)
# THREADS_USER_ID는 숫자 형태의 Threads 사용자 ID입니다 (@핸들이 아님)
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# ── Gemini API (소개글 생성) ──────────────────────
# https://aistudio.google.com 에서 발급
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── 소개글 스타일 (자유롭게 수정 가능) ────────────
POST_STYLE=20대 여성, 친근하고 공감 가는 말투, 반말 위주, 짧고 임팩트 있게

# ── 판매자 배송/반품 기본값 (쿠팡 상품등록용, product_uploader.py 전용) ──
# Wing → 상품관리 → 상품등록 화면의 기본값과 동일하게 입력
# 출고지/반품지 코드는 Wing → 설정 → 출고지/반품지 관리에서 확인
DELIVERY_COMPANY_CODE=
# DELIVERY_CHARGE_TYPE: FREE(무료) / NOT_FREE(유료) / CHARGE_ON_RETURN
DELIVERY_CHARGE_TYPE=FREE
DELIVERY_CHARGE=0
FREE_SHIP_OVER_AMOUNT=0
DELIVERY_CHARGE_ON_RETURN=3000
RETURN_CENTER_CODE=
RETURN_CHARGE_NAME=
COMPANY_CONTACT_NUMBER=
RETURN_ZIP_CODE=
RETURN_ADDRESS=
RETURN_ADDRESS_DETAIL=
RETURN_CHARGE=3000
AFTER_SERVICE_INFORMATION=판매자에게 문의
AFTER_SERVICE_CONTACT_NUMBER=
OUTBOUND_SHIPPING_PLACE_CODE=
VENDOR_USER_ID=
